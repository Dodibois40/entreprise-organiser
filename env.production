# Configuration de production pour O2Switch
NODE_ENV=production

# Base de données PostgreSQL O2Switch
DATABASE_URL="postgresql://cexe9174_cexe9174:rm9q-Pagd-QKP!@volant.o2switch.net:5432/cexe9174_cexe9174"

# JWT Configuration
JWT_SECRET="your-super-secret-jwt-key-change-this-in-production-2025"

# Upload Configuration
UPLOAD_PATH="/home/cexe9174/entreprise-organiser/uploads"

# CORS Configuration - Remplacez par votre domaine réel
FRONTEND_URL="https://votre-domaine.com"
CORS_ORIGIN="https://votre-domaine.com"

# Port de l'application (O2Switch gère automatiquement)
PORT=3000

# Firebase Configuration (si utilisé)
# FIREBASE_PROJECT_ID="your-project-id"
# FIREBASE_PRIVATE_KEY="your-private-key"
# FIREBASE_CLIENT_EMAIL="your-client-email"

# Email Configuration (optionnel)
# SMTP_HOST="smtp.o2switch.net"
# SMTP_PORT=587
# SMTP_USER="votre-email@votre-domaine.com"
# SMTP_PASS="votre-mot-de-passe-email"

# Logs
LOG_LEVEL="error"

# Security
BCRYPT_ROUNDS=12

# File Upload Limits
